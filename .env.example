# Duplicate to ~/.config/telegram-bridge/telegram.env and chmod 600.
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_DELIVERY=steer
TG_AUTOSTART=1
OPENCODE_SESSION_MODE=auto
# Leave unset to auto-detect Cursor Agent (when installed), otherwise use OpenCode.
# Set explicitly to opencode, claude-code, codex, or cursor to override detection.
# TELECODE_AGENT=
# Cursor CLI inbound routing (optional; Cursor needs an existing project workspace).
# CURSOR_AGENT_BIN=agent
# CURSOR_WORKSPACE=/path/to/project
TG_SEND_ROOTS=~/.config/telegram-bridge/files
