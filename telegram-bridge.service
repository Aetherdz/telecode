[Unit]
Description=Telegram Bridge for coding-agent CLI sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=TELEGRAM_BRIDGE_HOME=%h/.config/telegram-bridge
ExecStart=/usr/bin/env python3 %h/.local/share/telegram-bridge/tg_bridge.py listen
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.config/telegram-bridge %h/.local/share/telegram-bridge

[Install]
WantedBy=default.target
